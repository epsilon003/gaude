# --- Primary LLM: Google AI Studio (Gemini) ---
# Get a free key (no card required): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Fallback LLM: OpenRouter free-tier models ---
# Get a free key (no card required): https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

