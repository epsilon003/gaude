# Copy this file to .env and fill in what you need.
# You only strictly need one of GEMINI_API_KEY / OPENROUTER_API_KEY, but
# having both means the automatic failover actually has somewhere to fall
# back to.

# --- Generation providers (both OpenAI-compatible, both free-tier) ---
# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key, no card required: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: pin specific model IDs. Free-tier model IDs rotate over time --
# if you get a 404 "model not found", check the current lineup at
# https://ai.google.dev/gemini-api/docs/models and
# https://openrouter.ai/models?order=pricing-low-to-high and update here.
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_MODEL=openrouter/free

# --- Local models (optional overrides) ---
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Backend / CORS ---
# Comma-separated list of origins the FastAPI backend will accept requests
# from. Defaults to the Next.js dev server on both localhost and 127.0.0.1
# if unset -- only needed if your frontend runs somewhere else (e.g. a
# deployed Vercel URL).
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Windows only ---
# Hugging Face caches downloaded models to C:\Users\...\.cache by default.
# If you hit a "not enough free disk space" error, point it elsewhere:
# HF_HOME=D:\huggingface_cache
